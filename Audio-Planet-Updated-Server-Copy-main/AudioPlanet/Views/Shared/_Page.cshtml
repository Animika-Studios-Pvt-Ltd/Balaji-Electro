@using AudioPlanet.Models
<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewBag.Title</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="@ViewBag.Description" />
    <meta name="keywords" content="@ViewBag.Keywords"/>
    <link rel="shortcut icon" href="/Content/fevicon.ico" type="image/ico" />
    
    <meta name="google-site-verification" content="Cqt8astmmMcw31s4kSX3qSB7FPboPTCw01YzSh8Gnnw" />
    @*<link href="@Url.Content("/css/bootstrap.min.css")" type="text/css" rel="stylesheet" />*@
	<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
    @*<link href="@Url.Content("/css/custom.css")" type="text/css" rel="stylesheet" />*@
    <link href="@Url.Content("/css/custom.min.css")" type="text/css" rel="stylesheet" />
    <link href='http://fonts.googleapis.com/css?family=Droid+Sans' rel='stylesheet' type='text/css'>
	<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css">
    <style title="audio">
       @* @@import "@Url.Content("/css/bootstrap.min.css")";
        @@import "@Url.Content("/css/custom.css")";*@
        @@import "@Url.Content("/Scripts/Twitter/jquery.tweet.css")";
        @@import "@Url.Content("/Scripts/Scroll/jquery.mCustomScrollbar.css")";
        @@import "@Url.Content("/Scripts/fancy/jquery.fancybox.css")";

        .row1{
            margin-top:30px;
            margin-bottom:60px;
        }
    </style>

    <!--[if lt IE 9]>
     <script src="http://ie7-js.googlecode.com/svn/version/2.0(beta3)/IE9.js" 
     type="text/javascript">
     </script>
     <script src="http://ie7-js.googlecode.com/svn/version/2.0(beta3)/IE9-squish.js" 
     type="text/javascript">
     </script>
    <![endif]-->
    <script src="http://code.jquery.com/jquery-1.9.1.js"></script>
    <script src="http://code.jquery.com/ui/1.10.3/jquery-ui.js"></script>
</head>





<body>
    <input type="hidden" id="actionVal" value="@HttpContext.Current.Request.RequestContext.RouteData.Values["url"]"/>
    @Html.Partial("../Home/_Header")

<div class="outer_container clearfix">
    <div class="InnerContentPanel">
        <div class="inner_container">
            @RenderBody()
        </div>
    </div>
</div>

    @Html.Partial("../Home/_Footer")
    @{
        if (!Convert.ToString(HttpContext.Current.Request.RequestContext.RouteData.Values["url"]).Equals("contact", StringComparison.InvariantCultureIgnoreCase))
        {
            Html.RenderPartial("ContactUs", new AudioPlanet.Areas.Enquiry.Models.Enquiry());
        }
    }
    <div class="FloatingMenu">
        <img src="/Content/Public/images/floatingMenu.png" usemap="#Map" alt="floating menu" />
        <map name="Map" id="Map">
            <area shape="rect" coords="1,4,43,49" href="http://www.facebook.com/pages/Audio-Planet/422869287795501"
                target="_blank" alt="Facebook" />
            <area shape="rect" coords="-3,53,43,95" href="https://twitter.com/AudioPlanetHub"
                target="_blank" alt="twitter" />
        </map>
    </div>
   @* <div class="loading" id="ajaxLoading">
        <div>
            <img src="/Content/Public/images/loading.png" alt="" />
        </div>
    </div>*@
    @if (ViewBag.PageGroup == PageGroup.Product.ToString())
    {
        <script src="/Scripts/fancy/jquery.fancybox.js"></script>
        <script src="/Scripts/fancy/jquery.widgets.js"></script>
        <script src="/Scripts/fancy/jquery.fancybox-buttons.js"></script>
        <script src="/Content/Public/js/jquery.lazyload.js"></script>
    }
    @if (ViewBag.PageCode == "ExpertSpeaks")
    {
        <script src="/Content/Public/js/jquery.cycle.all.js"></script>
        <script src="/Content/Public/js/article.js"></script>
    }
    else
    {
        <script src="/Scripts/scroll/jquery.mCustomScrollbar.concat.min.js"></script>
        @*<script src="/Content/Public/js/inner.js" type="text/javascript"></script>*@
        <script src="/Content/Public/js/inner.min.js" type="text/javascript"></script>
    }

    @*<script src="/script/bootstrap.min.js"></script>*@
	<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>

    <script src="http://ajax.aspnetcdn.com/ajax/jquery/jquery-1.9.0.min.js"></script>
    <!--Jquery UI CDN (Microsoft)-->
    <script src="http://ajax.aspnetcdn.com/ajax/jquery.ui/1.10.3/jquery-ui.js"></script>
    @*<script type="text/javascript" src="/script/custom.js"></script>*@

    <script>
        (function (i, s, o, g, r, a, m) {
            i['GoogleAnalyticsObject'] = r; i[r] = i[r] || function () { (i[r].q = i[r].q || []).push(arguments); }, i[r].l = 1 * new Date(); a = s.createElement(o), m = s.getElementsByTagName(o)[0]; a.async = 1; a.src = g; m.parentNode.insertBefore(a, m)
        })(window, document, 'script', '//www.google-analytics.com/analytics.js', 'ga');
        ga('create', 'UA-41906781-1', 'audioplanet.co.in');
        ga('send', 'pageview');
    </script>
    <script>
        (function () {
            var p5 = document.createElement('script'); p5.type = 'text/javascript';
            p5.src = ('https:' == document.location.protocol ? 'https://' : 'http://') + 'src.plumb5.com/audioplanet_co_in_1704.js';
            var p5s = document.getElementsByTagName('script')[0]; p5s.parentNode.insertBefore(p5, p5s);
        })();
    </script>

</body>
</html>
