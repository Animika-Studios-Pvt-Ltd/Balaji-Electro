@model AudioPlanet.Areas.Enquiry.Models.Enquiry
<script src="@Url.Content("/Scripts/jquery.validate.min.js")"> </script>
<script src="@Url.Content("/Scripts/jquery.validate.unobtrusive.min.js")"> </script>

<div class="EnqueryPanel">
	<div class="enqThumb">
		<img src="/Content/Public/images/ConsultUS_thumb.png" alt="ConsultUs"/>
	</div>
	<div class="Enquery">
		<div class="cancle">
			<img src="/Content/Public/images/contactusnavigation.png" alt="Enquiry"/>
		</div>
		@*<div style="float: left; margin-left: 10px;">*@
        @*<div style="float: left; margin-left: 46px;">*@
			<div class="EnquiryText">
			@*@using (Html.BeginForm("Create", "Enquiry", new { area = "Enquiry" }, FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <table class="table-width">
                    <tr>
                        <td class="enqHead">
                            Enquiry
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="editor-field">
                                @Html.TextBoxFor(m => m.Name, new { @placeholder = "Name" })
                                @Html.ValidationMessageFor(m => m.Name)
                                @Html.Hidden("source", "main")
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="editor-field">
                                @Html.TextBoxFor(m => m.Email, new { @placeholder = "Email" })
                                @Html.ValidationMessageFor(m => m.Email)
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="editor-field">
                                @Html.TextBoxFor(m => m.Phone, new { @placeholder = "Phone", onkeypress = "return isNumberKey(event)", @maxlength = "12" })
                                @Html.ValidationMessageFor(m => m.Phone)
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="editor-field">
                                @Html.TextAreaFor(m => m.Query, new { @class = "TextArea", @placeholder = "Enquiry / Feedback" })
                                @Html.ValidationMessageFor(m => m.Query)
                            </div>
                            <input type="hidden" value="@HttpContext.Current.Request.UserHostAddress" name="IpAddress"/>
                            <input type="hidden" value="@if (HttpContext.Current.Request.UrlReferrer != null)
                                                        {
                                                @HttpContext.Current.Request.UrlReferrer
                                                        }
                                                        else
                                                        {
                                                @HttpContext.Current.Request.RawUrl                                            
                                                        }
                                               " name="ReferralUrl" />
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="editor-field">
                                <a>
                                    <img alt="Captcha" src="@Url.Action("CaptchaImage","Enquiry")" style="" />
                                </a>
                            </div>                                            
                            <div class="editor-field">
                                @Html.TextBoxFor(model => model.Captcha, new Dictionary<string, object> { { "placeholder", "Enter verification code" } })
                                @Html.ValidationMessageFor(model => model.Captcha)
                            </div> 
                        </td>
                    </tr>
                    <tr>
                         <td class="td-valign">
                            <input type="image" src="/Content/Public/images/submit.png" alt="Submit" />
                        </td>

                    </tr>
                </table>
            }*@
			<h3>Audio Planet </h3>
            @*<h5 style="font-weight:550">Most Trusted Home Theatre Specialist</h5> *@
            <p><span class="EnquiryTextHeader">Most Trusted Home Theatre Specialist</span></p>
            <p>We prefer to speak to you in order to understand your
            home theatre requirements in detail.</p> 
 			<p>We meet on appointments only.</p>
				
            <p>Kindly call us from<br/>
 
            Tue - Sun  11:00 AM to 8:00 PM</p>
 
            <p>Monday weekly Holiday</p>
 
            <p>on 080-25523016<br/> 
            +91 - 9845694986<br/>
            +91 - 9845019192</p>
		</div>
	</div>
</div>







