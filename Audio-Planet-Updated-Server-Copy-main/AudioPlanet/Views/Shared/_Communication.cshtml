@model AudioPlanet.Areas.Enquiry.Models.Enquiry

<style type="text/css">
    .image-field img
    {
        margin-top:12px;
    }
</style>

<script src="@Url.Content("/Scripts/jquery.validate.min.js")" type="text/javascript"> </script>
<script src="@Url.Content("/Scripts/jquery.validate.unobtrusive.min.js")" type="text/javascript"> </script>

<div class="form_container">
    @using (Html.BeginForm("Create", "Enquiry", new { area = "Enquiry" }, FormMethod.Post, new { enctype = "multipart/form-data", @class = "form_fields clear_fix" }))
    {
        <div class="editor-field">
                    @Html.TextBoxFor(m => m.Name, new { @placeholder = "Name" })
                    @Html.ValidationMessageFor(m => m.Name)
                    @Html.Hidden("source", "communication")
        </div>
        <div class="editor-field">
                    @Html.TextBoxFor(m => m.Email, new { @placeholder = "Email" })
                    @Html.ValidationMessageFor(m => m.Email)
        </div>
        <div class="editor-field">
                    @Html.TextBoxFor(m => m.Phone, new { @placeholder = "Phone", onkeypress = "return isNumberKey(event)", @maxlength = "12" })
                    @Html.ValidationMessageFor(m => m.Phone)
        </div>

        <div class="editor-field">
                    @Html.TextAreaFor(m => m.Query, new { @class = "TextArea", @placeholder = "Enquiry / Feedback" })
                    @Html.ValidationMessageFor(m => m.Query)
        </div>
        <div class="editor-field image-field">
            <a href="@Url.Action("Enquiry")">
                <img alt="Captcha" src="@Url.Action("CaptchaImage", "Enquiry")" style="" />
            </a>
        </div>                                            
        <div class="editor-field">
            @Html.TextBoxFor(model => model.Captcha, new Dictionary<string, object> { { "placeholder", "Enter verification code" } })
            @Html.ValidationMessageFor(model => model.Captcha)
        </div> 
                <input type="hidden" value="@HttpContext.Current.Request.UserHostAddress" name="IpAddress"/>
                <input type="hidden" value="@if (HttpContext.Current.Request.UrlReferrer != null)
                                            {@HttpContext.Current.Request.UrlReferrer}
                                            else
                                            {@("Direct")}" name="ReferralUrl" />
        <input type="submit" value="Submit" />
    }
</div>
<script type="text/javascript">
    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        return charCode <= 31 || (charCode >= 48 && charCode <= 57) || charCode == 43 || charCode == 45;
    }
</script>

