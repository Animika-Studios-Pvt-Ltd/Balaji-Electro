@using AudioPlanet.Models
@{
    Layout = null;
    var db = new Audio();
}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Mezzo System A and Triangle Galaxy 2</title>
    <link href="/Content/Public/Campaign/Camp1/css/landingPagestyles.css" rel="stylesheet"
        type="text/css" />
    <!--[if lt IE 9]>
     <script src="http://ie7-js.googlecode.com/svn/version/2.0(beta3)/IE9.js" 
     type="text/javascript">
     </script>
     <script src="http://ie7-js.googlecode.com/svn/version/2.0(beta3)/IE9-squish.js" 
     type="text/javascript">
     </script>
    <![endif]-->
    <script src="http://code.jquery.com/jquery-1.9.1.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $(function () {
                $(".Enquery").hide();
                $(".enqThumb").click(function () {
                    $(".Enquery").toggle("slow");
                    return false;
                });
                $(".cancle").click(function () {
                    $(".Enquery").hide();
                    return false;
                });
            });

            $(".enquiryNow").click(function () {
                $(".Enquery").toggle("slow");
                return false;
            });
        });
    </script>
</head>
<body>
    <div class="PageWrap">
        <div class="PageHeader">
            <h2>
                Your journey to being an Audiophile now begins at just
                <br />
                <span>1.5 lakhs</span></h2>
            <h3>
                Ultimate combos, unmatched performance to bring the music fanatic in you</h3>
        </div>
        <div class="PageContent">
            <div class="Products">
                <div class="ProductsContent">
                    <h2>
                        Mezzo System A</h2>
                    <div class="ProductsImg">
                        <a href="#">
                            <img src="/Content/Public/Campaign/Camp1/images/MezzoSystemimg.jpg" width="468" height="285"
                                 alt="" /></a>
                    </div>
                    <p>
                        This surround sound setup delivers a pure and accurate sound, thanks to Mezzo's
                        innovative speakers, yet it won't break the bank. Serious home cinema out of the
                        box. The Mezzo 5.1 System features four Mezzo 1 speakers for left and right, front
                        and rear channels, a Mezzo 5 dedicated centre channel and a stunning Mezzo 9 subwoofer
                        for bass. The five main speakers all feature the patented ATT aspirated tweeter
                        for crystal-clear high notes - as well as high-end components hand-picked by our
                        designers throughout. Stylish, stunning audio and simple to set up.</p>
                    <h3 style="margin-top: 26px;">
                        What You Get?</h3>
                    <div class="Productsitems">
                        <div class="itemsList">
                            <span>2 pairs x Mezzo 1 bookshelf speakers</span><br />
                            <span>1 single x Mezzo 5 centre speaker</span><br />
                            <span>1 single x Mezzo 9 subwoofer</span>
                        </div>
                        <div class="and">
                            &amp;</div>
                        <div class="Extraitems">
                            <span>A Denon</span><br />
                            <span>AVRX 1000</span>
                        </div>
                    </div>
                    <span class="Pricetag">Original Combo Price:
                        <img src="/Content/Public/Campaign/Camp1/images/rupee.jpg" width="8" height="12"
                             alt="" />
                        1,99,000</span>
                    <div class="PriceBox">
                        <span>OFFER PRICE</span> <span class="Rupees">1,49,000</span>
                    </div>
                </div>
                <div class="enquirenowbox">
                    <a href="#" class="enquiryNow">
                        <img src="/Content/Public/Campaign/Camp1/images/enquirenowimg.jpg" width="470" height="64"
                             alt="" /></a>
                </div>
            </div>
            <div class="Products" style="margin-left: 38px;">
                <div class="ProductsContent">
                    <h2>
                        Triangle Galaxy 2</h2>
                    <div class="ProductsImg">
                        <a href="#">
                            <img src="/Content/Public/Campaign/Camp1/images/triangleGalaxyimg.jpg" width="468"
                                 height="285" alt="" /></a>
                    </div>
                    <p>
                        Get acquainted to the "easy living" audio-video concept. The Galaxy 2 system was
                        developed around the concept of "easy living." The idea is to promote perfect integration
                        and use at different levels. To meet the expectations of the most demanding listeners,
                        this concept makes it possible to build an infinite number of hi-fi and home video
                        configurations, and even music systems for public venues. The extraordinary satellite
                        speakers powered with a woofer with breathtaking energy is handcrafted to extract
                        all the qualities that reproduce the effect, plunging the film-loving listeners
                        into the very heart of action.</p>
                    <h3>
                        What You Get?</h3>
                    <div class="Productsitems">
                        <div class="itemsList" style="margin-top: 10px;">
                            <span>Galaxy 2 five satellite speakers</span><br />
                            <span>Meteor 0.1 Tc subwoofer</span><br />
                        </div>
                        <div class="and">
                            &amp;</div>
                        <div class="Extraitems">
                            <span>A Denon</span><br />
                            <span>AVRX 1000</span>
                        </div>
                    </div>
                    <span class="Pricetag">Original Combo Price:
                        <img src="/Content/Public/Campaign/Camp1/images/rupee.jpg" width="8" height="12"
                             alt="" />
                        1,99,000</span>
                    <div class="PriceBox">
                        <span>OFFER PRICE</span> <span class="Rupees">1,70,000</span>
                    </div>
                </div>
                <div class="enquirenowbox">
                    <a href="#" class="enquiryNow">
                        <img src="/Content/Public/Campaign/Camp1/images/enquirenowimg.jpg" width="470" height="64"
                             alt="" /></a>
                </div>
            </div>
        </div>
        <div class="Footer">
            <div class="Link1">
                <a href="/">More about Audio Planet</a></div>
            <div class="Link2">
                <a href="/Systems/Products-and-Brands">More about Products</a>
            </div>
        </div>
    </div>
    @{Html.RenderPartial("ContactUs", new AudioPlanet.Areas.Enquiry.Models.Enquiry());}
</body>
</html>
