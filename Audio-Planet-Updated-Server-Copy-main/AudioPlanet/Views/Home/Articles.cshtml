@using AudioPlanet.Models
@model AudioPlanet.Models.Page
@{
    Layout = "~/Views/Shared/_Page.cshtml";
    ViewBag.Title = Model.Title;
    ViewBag.Keywords = Model.Keyword;
    ViewBag.Description = Model.Description;
    ViewBag.PageGroup = Model.PageGroup;
    ViewBag.PageCode = Model.PageCode;
}
<div class="container">
    <div class="row">
        <div class="col-lg-8 col-md-8 col-sm-8">
            <div class="ArticlesLeftPanel">
            <div class="row">
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12">
                <h1>Articles</h1>
                </div>
                <div class="col-lg-5 col-md-5 col-sm-5 col-xs-12">
                    @{ Html.RenderPartial("Widgets/SearchArticle"); }
                </div>
            </div>
            <div  id="ArticlesLeftPanel"> 
                @{
                    Html.RenderPartial("Widgets/FeaturedArticles", (IEnumerable<Article>)ViewBag.FeaturedArticles);
                }
            </div>
            </div>
            <div class="ArticlesDiv"></div>
        </div>
        <div class="col-lg-4 col-md-4 col-sm-4">
            <div class="ArticlesRightPanel" id="ArticlesRightPanel">
                @{
                    Html.RenderPartial("Widgets/ArticleCategories", (IEnumerable<AudioPlanet.Models.Page>)ViewBag.Categories);
                    Html.RenderPartial("Widgets/LatestArticles", (IEnumerable<Article>)ViewBag.LatestArticles);
                }
            </div>
            <div class="ArticlesDiv"></div>
        </div>
    </div>
</div>











