<div class="container">
    <div class="row1">
        <div class="row">
            <div class="col-lg-8 col-md-8 col-sm-8">
                <div class="ArticlesLeftPanel">
                    <div  id="ArticlesLeftPanel" itemscope itemtype="http://schema.org/ScholarlyArticle">
                        <div class="ArticlesHead">
                            <div class="ArtcilesTitle">
                                <h1 itemprop="name">@Model.Title</h1>
                                <span itemprop="datePublished">Posted on @(Model.PostedTime.ToString("dd / MM / yyyy"))</span>
                                <a href="#" data-src="@(new AudioHelper().GetUrl("Article", Model.Url))" class="shareFB">
                                <img src="/Content/Public/images/share_fb.png" alt="share on facebook"></a>
                            </div>
                        </div>
                        @if (Model.Url == "Audio-Planet--Featured-in-Times-of-India-Page-3-30th-July")
                        {
                             <div class="ArticlesDetails">
                                <img src="/Content/Public/images/Featured_Times_of_India_Audio_Planet.jpg" alt="featured on times of india"/>
                            </div>
                        }
                        else
                        {
                            <div class="ArticlesDetails">
                                @Html.Raw(Model.Content)
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-4 col-sm-4">
                <div class="ArticlesRightPanel" id="ArticlesRightPanel">
                    @{
                        Html.RenderPartial("Widgets/SearchArticle");
                        Html.RenderPartial("Widgets/ArticleCategories", (IEnumerable<AudioPlanet.Models.Page>)ViewBag.Categories);
                        Html.RenderPartial("Widgets/LatestArticles", (IEnumerable<Article>)ViewBag.LatestArticles);
                    }
                </div>
                <div class="ArticlesDiv"></div>
            </div>
        </div>
    </div>
</div>