    @{
        var db = new Audio();
        var cats = db.Categories;
        var brands = db.Brands;
            
        
    <div class="row">
        <div class="side-bar">
           
            <div id="badCat" class="category-bar">
                <h3>Categories</h3>
                @foreach (Category item in cats )
                {
                <ul>
                    @*<li>@Html.ActionLink(@item.CategoryName, "brandCategory", new {id = item.ID})</li>*@
                    <li><a href="javascript:void(0);" onclick="NavigatePage();">@item.CategoryName</a></li>
                </ul>
                    }
            </div>
            <div class="brand-bar">
                <h3>Brands</h3>
                @foreach (Brand item in brands )
                {
                <ul>
                    <li>@item.BrandName</li>
                </ul>
                    }
            </div>
            
        </div>
    </div>
  
    }

    
@{
    <div id="AmplifierDetails" class="marginleft">
        <ul>
            @foreach (var item in Model)
            {
                <li>
                    <div class="Amplifier_topDivMiddle">
                        <div class="Amplifier_innerdiv">
                            <div class="AmplifierDetails_img">
                                @{
                                    <a style="color: #333333" data-fancybox-type="ajax" class="fancybox" title="@item.Name" href="/Home/ProductDeatils/@item.ID">
                                        <img class="lazy" src="/Content/Public/images/grey.gif" data-original="@(Product.GetProductFiles(item.ID, "Image"))" width="250px" height="250px" alt="@item.Name"/>
                                    </a>
                                }
                            </div>
                            <div>
                                <h2>
                                    <a style="color: #333333" title="@item.Name" data-fancybox-type="ajax" class="fancybox" href="/Home/ProductDeatils/@item.ID">@item.Name</a>
                                </h2>
                                <p>@Html.Raw(item.Description)</p>
                                @{
                                    var path = Product.GetProductFiles(item.ID, "Document");
                                }
                                @if (!string.IsNullOrEmpty(path))
                                {
                                    <a href="@path" class="fancyboxPdf downloadPdf" data-fancybox-type="iframe">
                                        <img src="/Content/Public/images/downloadPdf.png" alt="" /></a>
                                }
                                else
                                {
                                    <a href="#" class="downloadPdf">
                                        <img src="/Content/Public/images/downloadPdf.png" alt="" /></a>
                                }
                                 <a href="/Systems/Enquiry" class="downloadPdf">
                                            <img src="/Content/Public/images/enquire.png" alt="Know more about @(item.Name)" /></a>
                            </div>
                        </div>
                    </div>
                </li>
            }
        </ul>
    </div>
}

<script type="text/javascript">
    function NavigatePage() {
        var selectedValue = document.getElementById('badCat').value;
        if(selectedValue == "Bicycle")
            document.location = '@Url.Action("Index", "BicycleSellerListing")';
    else if(selectedValue == "Tennis")
        document.location = '@Url.Action("Index", "BicycleSellerListing")';
    else if // add as needed
    }
</script>

<script type="text/javascript">
    $(document).ready(function () {
        if ($(".fancyboxPdf").length > 0) {
            $(".fancyboxPdf").fancybox({
                openEffect: 'elastic',
                closeEffect: 'elastic',
                openEasing: 'swing'
            });
        }
        if ($(".fancybox").length > 0) {
            $(".fancybox").fancybox({
                maxWidth: 800,
                maxHeight: 600,
                fitToView: false,
                width: '500px',
                height: 'auto',
                autoSize: false,
                closeClick: false,
                openEffect: 'elastic',
                closeEffect: 'elastic',
                openEasing: 'swing',
                beforeShow: function () {
                    if (this.title) {
                        // New line
                        this.title += '<br />';

                        // Add tweet button
                        this.title += '<a href="https://twitter.com/share" class="twitter-share-button" data-count="none" data-url="' + this.href + '">Tweet</a> ';

                        // Add FaceBook like button
                        this.title += '<iframe src="//www.facebook.com/plugins/like.php?href=' + this.href + '&amp;layout=button_count&amp;show_faces=true&amp;width=500&amp;action=like&amp;font&amp;colorscheme=light&amp;height=23" scrolling="no" frameborder="0" style="border:none; overflow:hidden; width:110px; height:23px;" allowTransparency="true"></iframe>';
                    }
                },
                afterShow: function () {
                    // Render tweet button
                    twttr.widgets.load();
                },
                helpers: {
                    title: {
                        type: 'outside'
                    },
                    overlay: {
                        css: {
                            'background': 'rgba(238,238,238,0.85)'
                        }
                    }
                }
            });
        }
    });
</script>

    @Html.Partial("../Home/_Footer")



