<body>
<!--========================== Header===========================-->
<div class="outer_container clearfix">

    <nav class="navbar navbar-inverse">

        <div class="inner_container clearfix">
            <div class="col-lg-3 col-md-3 col-sm-12 padding_zero">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navHeaderCollapse">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>

                    <div class="logo_container clearfix">
                        <a href="/"><img src="/images/AudioPlanet_Logo.png" class="img-responsive" alt="AudioPlanet"></a>
                    </div>
                </div>
            </div>
            <div class="col-lg-9 col-md-9 col-sm-12 padding_zero">
                <div class="collapse navbar-collapse navHeaderCollapse">
                    @Html.Raw(new AudioHelper().MainMenu().ToString())
                </div>
            </div>
        </div>
        <!--</div>-->
    </nav>
</div>
<!--=========================== Banner =============================-->

<div class="outer_container clearfix">
    <div class="HomeBanner_bg">
        <div class="HomeBannerBackground">
            <div class="inner_container clearfix">
                <div class="container">
                    <div class="Gallery">
                        <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                            <div class="GaleryLeftPanel">
                                <img id="img1" class="glry glryimg1 img-responsive" src="images/2.png" alt="Home theater systems in Bangalore"/>
                            </div>
                        </div>
                        <div class="col-lg-8 col-md-8 col-sm-8 col-xs-8">
                            <div class="GalleryMiddlePanel">
                                <img id="img2" class="glry glryimg2 img-responsive" src="images/3L.png" alt="audio systems in bangalore"/>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-2 col-sm-2 col-xs-2">
                            <div class="GaleryRightPanel">
                                <img id="img3" class="glry glryimg3 img-responsive" src="images/1.png" alt="bangalore home theater dealers"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    <div id="myCarousel" class="feedback_container carousel slide" data-ride="carousel" data-interval="false">
    <ol class="carousel-indicators">
      <li data-target="#myCarousel" data-slide-to="0" class="active"></li>
      <li data-target="#myCarousel" data-slide-to="1"></li>
    </ol>
    <div class="carousel-inner">
        <div class="feedback_hood clear_fix">
                <img src="/Content/Public/images/video.png" alt="audio-planet">
            </div>

      <div class="item active feedback_form_container">
          @*<iframe width="100%" height="250" src="https://www.youtube.com/embed/KZx0SRkQgAQ?rel=0&amp;showinfo=0" frameborder="0" allowfullscreen></iframe>*@
