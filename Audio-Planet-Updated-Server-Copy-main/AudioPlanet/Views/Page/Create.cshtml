@model AudioPlanet.Models.Page
@{
    ViewBag.Title = "Create";
}
@section css{
    @@import "@Url.Content("~/Content/themes/Ucms/chosen.css")";
    @@import "@Url.Content("~/Content/themes/Ucms/tags-input.css")";
}

<h2 id="step0">
    Create Page</h2>
<div class="buttons">
    <a href="@Url.Action("Index")" class = "button left"><span class="icon icon63"></span>
        <span class="label">Primary Pages</span></a>
</div>
@using (Html.BeginForm())
{
    @Html.ValidationSummary(false, "Page creation was unsuccessful. Please correct the errors and try again.")
    <fieldset>
        <legend>Page</legend>
        <div class="editor-label">
            @Html.LabelFor(model => model.ParentId, "Parent Page")
        </div>
        <div class="editor-field" id="step1">
            @Html.DropDownList("ParentId", (SelectList)ViewBag.ParentId, " ", new Dictionary<string, object> { { "class", "chzn-select" }, { "style", "width: 350px;" }, { "tabindex", "4" } })
            @Html.ValidationMessageFor(model => model.ParentId)
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.Title)
        </div>
        <div class="editor-field" id="step2">
            @Html.TextBoxFor(model => model.Title, new Dictionary<string, object> { { "class", "replication" } })
            @Html.ValidationMessageFor(model => model.Title)
            <div id="PageNameExist">
            </div>
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.SubTitle)
        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.SubTitle, new Dictionary<string, object> { { "class", "replication" } })
            @Html.ValidationMessageFor(model => model.SubTitle)
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.Name)
        </div>
        <div class="editor-field" id="step3">
            @Html.TextBoxFor(model => model.Name, new Dictionary<string, object> { { "class", "replication" } })
            @Html.ValidationMessageFor(model => model.Name)
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.Order)
        </div>
        <div class="editor-field">
            @Html.EditorFor(model => model.Order)
            @Html.ValidationMessageFor(model => model.Order)
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.Content)
        </div>
        <div class="editor-field" id="step4">
            @Html.TextAreaFor(model => model.Content, new { @class = "mceEditor" })
            @Html.ValidationMessageFor(model => model.Content)
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.PageGroup)
        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.PageGroup)
            @Html.ValidationMessageFor(model => model.PageGroup)
        </div>
        <div>
            @foreach (var item in Enum.GetValues(typeof(AudioPlanet.Models.PageGroup)))
            {
                <span class="PGroup" style="color: #C98657; cursor: pointer; padding: 3px; text-decoration: underline;">
                    @item</span>
            }
        </div>
        <fieldset>
            <legend>SEO Options</legend>
            <div class="editor-label">
                @Html.LabelFor(model => model.Description)
            </div>
            <div class="editor-field" id="step5">
                @Html.TextAreaFor(model => model.Description, new Dictionary<string, object> { { "class", "replication" } })
                @Html.ValidationMessageFor(model => model.Description)
            </div>
            <div class="editor-label">
                @Html.LabelFor(model => model.Keyword)
            </div>
            <div class="editor-field" id="step6">
                @Html.TextBoxFor(model => model.Keyword, new { @class = "replication" })
                @Html.ValidationMessageFor(model => model.Keyword)
            </div>
            <div style="height: 100px; overflow: auto">
                <p>
                    Available Kewords
                    @{
                        var queryable = ViewBag.keywords as IQueryable<string>;
                        if (queryable != null)
                        {
                            foreach (string k in queryable)
                            {
                                <span class="key" style="color: #C98657; cursor: pointer; padding: 3px; text-decoration: underline;">@k</span>
                            }
                        }
                    }
                </p>
            </div>
            <div class="editor-label">
                @Html.LabelFor(model => model.Url)
            </div>
            <div class="editor-field" id="step7">
                @Html.TextBoxFor(model => model.Url)
                @Html.ValidationMessageFor(model => model.Url)
            </div>
        </fieldset>
        <p class="ibuttons">
            <input type="submit" value="Create" name="BtnSave" id="step8" class="ibutton save" />
            <input type="submit" value="Publish" name="BtnPublish" id="step9" class="ibutton flag" />
        </p>
    </fieldset>
}
<div class="buttons">
    <a href="@Url.Action("Index")" class = "button left"><span class="icon icon63"></span>
        <span class="label">Primary Pages</span></a>
</div>

@section script
{
    @Content.Script("jquery.validate.min.js", Url)
    @Content.Script("jquery.validate.unobtrusive.min.js", Url)
    @Content.Script("Ucms/chosen.jquery.js", Url)
    @Content.Script("tiny_mce/tiny_mce.js", Url)
    @Content.Script("Ucms/jquery-tiny-mce.js", Url)
    @Content.Script("Ucms/jquery.tagsinput.min.js", Url)
    <script type="text/javascript">
        $(document).ready(function() {
            $("#Title").keyup(function() {
                $(".replication").val(this.value);
                var dname_without_space = this.value.replace(/[^a-z0-9_&\s]/gi, '').replace(/[\s]/g, '-').replace(/[&]/g, 'and');
                $("input#Url").val(dname_without_space);
            });

            $(".replication").change(function() { $(this).removeClass("replication"); });

            $('#Keyword').tagsInput({
                'defaultText': 'add a keyword',
                'removeWithBackspace': true,
                'height': '50px',
                'width': '1000px'
            });

            $("span.key").click(function(e) { $('#Keyword').addTag($(this).html()); });

            $('#PageGroup').tagsInput({
                'defaultText': 'add a Page group',
                'removeWithBackspace': true,
                'height': '50px',
                'width': '1000px'
            });

            $('#PageGroup').addTag('Page');
            $("span.PGroup").click(function(e) { $('#PageGroup').addTag($(this).html()); });
        });

        $(document).keyup(function(e) { if (e.keyCode == 27) {
                                            $('.validation-summary-errors').remove();
                                        } });

    </script>
    <script type="text/javascript">
        $(".chzn-select").chosen();
        $(".chzn-select-deselect").chosen({ allow_single_deselect: true }); 
    </script>
}