@model AudioPlanet.Models.Page
@{
    ViewBag.Title = "Delete";
}
<div class="buttons">
    <a href="@Url.Action("SubPages", new {id = Model.ParentId})" class = "button left"><span class="icon icon63"></span><span class="label">Back To List</span></a>
</div>
<h2>
    Delete Page</h2>
<h3>
    Are you sure you want to delete this?
</h3>
@using (Html.BeginForm())
{
    <input type="submit" value="Delete" class="ibutton delete" />
}
<fieldset>
    <legend>Page</legend>
    <div class="display-label">
        Parent Page</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.ParentPage.Name)
    </div>
    <div class="display-label">
        Title</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.Title)
    </div>
    <div class="display-label">
        Name</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.Name)
    </div>
    <div class="display-label">
        Description</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.Description)
    </div>
    <div class="display-label">
        Content</div>
    <div class="display-field">
        @Html.Raw(Model.Content)
    </div>
    <div class="display-label">
        Keyword</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.Keyword)
    </div>
    <div class="display-label">
        Url</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.Url)
    </div>
    <div class="display-label">
        Is Parent</div>
    <div class="display-field">
        @if (Model.IsParent)
        {
            <span>Yes</span>
        }
        else
        {
            <span>No</span>
        }
    </div>
    <div class="display-label">
        Is Active
    </div>
    <div class="display-field">
        @if (Model.IsActive)
        {
            <span>Yes</span>
        }
        else
        {
            <span>No</span>
        }
    </div>
    <div class="display-label">
        Created At</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.CreatedAt)
    </div>
</fieldset>
<div class="buttons">
    <a href="@Url.Action("SubPages", new {id = Model.ParentId})" class = "button left"><span class="icon icon63"></span><span class="label">Back To List</span></a>
</div>