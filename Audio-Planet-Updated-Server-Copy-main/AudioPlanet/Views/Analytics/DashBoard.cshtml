@{
    ViewBag.Title = "Dash Board";
}

<h2>Dash Board</h2>
<!-- Add Google Analytics authorization button -->
<button id="authorize-button" style="visibility: hidden">
    Authorize Analytics</button>
<!-- Div element where the Line Chart will be placed -->
<div id='line-chart-example'>
</div>
<div id='table-chart-example'>
</div>
<!-- Load all Google JS libraries -->
<script src="https://www.google.com/jsapi" type="text/javascript"></script>
<script src="/GA/gadash-1.0.js" type="text/javascript"></script>
<script src="https://apis.google.com/js/client.js?onload=gadashInit" type="text/javascript"></script>
<script type="text/javascript">
    // Configure these parameters before you start.
    // clientId = '13776171299.apps.googleusercontent.com';
    // apiKey = 'AIzaSyBDk20iah9rM4t_91VSwbr__AJbi8sLyv8';
    // scopes = 'https://www.googleapis.com/auth/analytics.readonly';

    var API_KEY = 'AIzaSyBDk20iah9rM4t_91VSwbr__AJbi8sLyv8';
    var CLIENT_ID = '13776171299.apps.googleusercontent.com';
    var TABLE_ID = 'ga:66247072';
    // Format of table ID is ga:xxx where xxx is the profile ID.

    gadash.configKeys({
        'apiKey': API_KEY,
        'clientId': CLIENT_ID
    });

    // Create a new Chart that queries visitors for the last 30 days and plots
    // visualizes in a line chart.
    var chart1 = new gadash.Chart({
        'type': 'LineChart',
        'divContainer': 'line-chart-example',
        'last-n-days': 30,
        'query': {
            'ids': TABLE_ID,
            'start-date': lastNDays(14),
            'end-date': lastNDays(0),
            'metrics': 'ga:visitors, ga:visits, ga:pageviews',
            'dimensions': 'ga:date'
        },
        'chartOptions': {
            height: 300,
            legend: { position: 'bottom' },
            title: 'Visits of last 14 Days',
            hAxis: { title: 'Date' },
            vAxis: { title: 'Visits' },
            curveType: 'function'
        }
    }).render();


    var chart2 = new gadash.Chart({
        'divContainer': 'table-chart-example',
        'last-n-days': 30,
        'query': {
            'ids': TABLE_ID,
            'start-date': lastNDays(14),
            'end-date': lastNDays(0),
            'metrics': 'ga:visitors, ga:visits, ga:pageviews',
            'dimensions': 'ga:source,ga:medium',
            'sort': '-ga:visitors',
            'max-results': 100
        }
    }).render();

    function lastNDays(n) {
        var today = new Date();
        var before = new Date();
        before.setDate(today.getDate() - n);

        var year = before.getFullYear();

        var month = before.getMonth() + 1;
        if (month < 10) {
            month = '0' + month;
        }

        var day = before.getDate();
        if (day < 10) {
            day = '0' + day;
        }

        return [year, month, day].join('-');
    }
</script>
