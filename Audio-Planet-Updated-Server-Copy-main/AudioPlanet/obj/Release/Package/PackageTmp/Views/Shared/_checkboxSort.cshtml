@using AudioPlanet.Models
@model IEnumerable<Product>

 <link href="@Url.Content("css/bootstrap.min.css")" type="text/css" rel="stylesheet" />
    <link href="@Url.Content("css/custom.css")" type="text/css" rel="stylesheet" />
    <link href="@Url.Content("css/slick.css")" type="text/css" rel="stylesheet" />
    <link href='http://fonts.googleapis.com/css?family=Droid+Sans' rel='stylesheet' type='text/css'>
    <script src="http://code.jquery.com/jquery-1.9.1.js" type="text/javascript"></script>
    <script src="http://code.jquery.com/ui/1.10.3/jquery-ui.js" type="text/javascript"></script>
    

    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.1.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>





       
            @{
             
            <div id="AmplifierDetail" class="">
                <ul>
                    @foreach (var item in Model)
                    {
                        <li>
                            <div class="Amplifier_topDivMiddleNew">
                                <div class="Amplifier_innerdiv">
                                    <div class="AmplifierDetailsNew_img">
                                        @{
                                            <a style="color: #333333" data-fancybox-type="ajax" class="fancybox" title="@item.Name" href="@Url.Action("ProductDeatils", "Home", new { id=@item.ID,name=@item.Name})">
                                                <img class="thumbImage" src="@(Product.GetProductFiles(item.ID, "Image"))" data-original="@(Product.GetProductFiles(item.ID, "Image"))" width="220px" height="220px" alt="@item.Name"/>
                                            </a>
                                            
                                            @*@Html.Raw(new AudioUrl().urlName().ToString())*@

                                        }
                                    </div>
                                    <div>
                                        <h2>
                                            @*<a style="color: #333333" title="@item.Name" data-fancybox-type="ajax" class="fancybox" href="/Home/ProductDeatils/@item.ID/@item.Name"></a>*@
                                        
                                            @Html.ActionLink(@item.Name, "ProductDeatils", "Home", new { id = @item.ID, name = @item.Name }, new { @class="fancybox", @style="color:#333333"})
                                        </h2>
                                        <p>@Html.Raw(item.Description)</p>
                                        @{
                                            var path = Product.GetProductFiles(item.ID, "Document");
                                        }

                                        <div class="pdfImg">
                                        @if (!string.IsNullOrEmpty(path))
                                        {
                                            
                                            <a href="@path" class="fancyboxPdf downloadPdf" data-fancybox-type="iframe">
                                                <img src="/Content/Public/images/downloadPdf.png" alt="" /></a>
                                        }
                                        else
                                        {
                                            <a href="#" class="downloadPdf">
                                                <img src="/Content/Public/images/downloadPdf.png" alt="" /></a>
                                        }
                                        <a href="/Systems/Enquiry" class="downloadPdf">
                                            <img src="/Content/Public/images/enquire.png" alt="Know more about @(item.Name)" /></a>
                                            </div>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
        
    

<script type="text/javascript">
    $(document).ready(function () {
        if ($(".fancyboxPdf").length > 0) {
            $(".fancyboxPdf").fancybox({
                openEffect: 'elastic',
                closeEffect: 'elastic',
                openEasing: 'swing'
            });
        }
        if ($(".fancybox").length > 0) {
            $(".fancybox").fancybox({
                maxWidth: 800,
                maxHeight: 600,
                fitToView: false,
                width: '500px',
                height: 'auto',
                autoSize: false,
                closeClick: false,
                openEffect: 'elastic',
                closeEffect: 'elastic',
                openEasing: 'swing',
                beforeShow: function () {
                    if (this.title) {
                        // New line
                        this.title += '<br />';

                        // Add tweet button
                        this.title += '<a href="https://twitter.com/share" class="twitter-share-button" data-count="none" data-url="' + this.href + '">Tweet</a> ';

                        // Add FaceBook like button
                        this.title += '<iframe src="//www.facebook.com/plugins/like.php?href=' + this.href + '&amp;layout=button_count&amp;show_faces=true&amp;width=500&amp;action=like&amp;font&amp;colorscheme=light&amp;height=23" scrolling="no" frameborder="0" style="border:none; overflow:hidden; width:110px; height:23px;" allowTransparency="true"></iframe>';
                    }
                },
                afterShow: function () {
                    // Render tweet button
                    twttr.widgets.load();
                },
                helpers: {
                    title: {
                        type: 'outside'
                    },
                    overlay: {
                        css: {
                            'background': 'rgba(238,238,238,0.85)'
                        }
                    }
                }
            });
        }
    });
</script>

 <script type="text/javascript" src="script/bootstrap.min.js"></script>
