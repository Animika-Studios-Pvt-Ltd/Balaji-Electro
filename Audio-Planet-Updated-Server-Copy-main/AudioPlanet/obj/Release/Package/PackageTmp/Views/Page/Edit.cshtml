@model AudioPlanet.Models.Page
@{
    ViewBag.Title = "Edit";
}
@section css{
    @@import "@Url.Content("~/Content/themes/Ucms/chosen.css")";
    @@import "@Url.Content("~/Content/themes/Ucms/tags-input.css")";
}

@section script{
    @Content.Script("jquery.validate.min.js", Url)
    @Content.Script("jquery.validate.unobtrusive.min.js", Url)
    @Content.Script("tiny_mce/tiny_mce.js", Url)
    @Content.Script("Ucms/jquery-tiny-mce.js", Url)
    @Content.Script("Ucms/jquery.tagsinput.min.js", Url)
    <script type="text/javascript">
        $(document).ready(function() {
            $('#Keyword').tagsInput({
                'defaultText': 'add a keyword',
                'removeWithBackspace': true,
                'height': '50px',
                'width': '1000px'
            });

            $("span.key").click(function(e) { $('#Keyword').addTag($(this).html()); });

            $('#PageGroup').tagsInput({
                'defaultText': 'add a Page group',
                'removeWithBackspace': true,
                'height': '50px',
                'width': '1000px'
            });

            //$('#PageGroup').addTag('Page');
            $("span.PGroup").click(function(e) { $('#PageGroup').addTag($(this).html()); });

            $('input#Url').bind('keypress', function(event) {
                var regex = new RegExp("^[a-zA-Z0-9_-]+$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                //allow Backspace
                if (event.which == 8) {
                    return true;
                }
                if (!regex.test(key)) {
                    event.preventDefault();
                    return false;
                }
                return true;
            });
        })
    </script>
}

<h2>
    Edit Page: "@Model.Name"</h2>
<div class="buttons">
    <a href="@Url.Action("SubPages", new { id = Model.ParentId })" class = "button left">
        <span class="icon icon63"></span><span class="label">Sub Pages</span></a>
</div>
@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)
    <fieldset>
        <legend>Page</legend>
        @Html.HiddenFor(model => model.ID)
        @Html.HiddenFor(model => model.ParentId)
        @Html.HiddenFor(model => model.PageCode)
        @Html.HiddenFor(model => model.IsPublished)
        <div class="editor-label">
            @Html.LabelFor(model => model.ParentId, "Parent Page")
        </div>
        <div class="editor-field">
            @Html.DropDownList("ParentId", String.Empty)
            @Html.ValidationMessageFor(model => model.ParentId)
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.Title)
        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.Title, new { @class = "replication" })
            @Html.ValidationMessageFor(model => model.Title)
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.SubTitle)
        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.SubTitle, new { @class = "replication" })
            @Html.ValidationMessageFor(model => model.SubTitle)
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.Name)
        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.Name, new { @class = "replication" })
            @Html.ValidationMessageFor(model => model.Name)
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.Order)
        </div>
        <div class="editor-field">
            @Html.EditorFor(model => model.Order)
            @Html.ValidationMessageFor(model => model.Order)
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.Description)
        </div>
        <div class="editor-field">
            @Html.EditorFor(model => model.Description)
            @Html.ValidationMessageFor(model => model.Description)
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.Content)
        </div>
        <div class="editor-field">
            @Html.TextAreaFor(model => model.Content, new { @class = "mceEditor" })
            @Html.ValidationMessageFor(model => model.Content)
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.PageGroup)
        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.PageGroup)
            @Html.ValidationMessageFor(model => model.PageGroup)
        </div>
        <div>
            @foreach (var item in Enum.GetValues(typeof(AudioPlanet.Models.PageGroup)))
            {
                <span class="PGroup" style="color: #C98657; cursor: pointer; padding: 3px; text-decoration: underline;">
                    @item</span>
            }
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.Keyword)
        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.Keyword, new { @class = "replication" })
            @Html.ValidationMessageFor(model => model.Keyword)
        </div>
        <div style="height: 100px; overflow: auto">
            <p>
                Available Kewords
                @foreach (string k in (IQueryable<string>)ViewBag.keywords)
                {
                    <span class="key" style="color: #C98657; cursor: pointer; padding: 3px; text-decoration: underline;">@k</span>
                }
            </p>
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.Url)
        </div>
        <div class="editor-field">
            @Html.TextBoxFor(model => model.Url)
            @Html.ValidationMessageFor(model => model.Url)
            @Html.Hidden("initialUrl", Model.Url)
        </div>
        <p class="ibuttons">
            <input type="submit" value="Save" name="BtnUpdate" class="ibutton save" />
        </p>
    </fieldset>
}
<div class="buttons">
    <a href="@Url.Action("SubPages", new { id = Model.ParentId })" class = "button left">
        <span class="icon icon63"></span><span class="label">Sub Pages</span></a>
</div>
