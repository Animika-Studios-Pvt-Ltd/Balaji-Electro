@using AudioPlanet.Helpers

<div class="outer_container clearfix">
    <nav class="navbar navbar-inverse">
        <div class="inner_container clearfix">
            <div class="col-lg-3 col-md-3 col-sm-12 padding_zero">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navHeaderCollapse">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>

                    <div class="logo_container clearfix">
                        <a href="/"><img src="/images/AudioPlanet_Logo.png" class="img-responsive" alt="AudioPlanet"></a>
                    </div>
                </div>
            </div>
            <div class="col-lg-9 col-md-9 col-sm-12 padding_zero">
                <div class="collapse navbar-collapse navHeaderCollapse">
                    @Html.Raw(new AudioHelper().MainMenu().ToString())
                </div>
            </div>
        </div>
        <!--</div>-->
    </nav>
</div>
@{ if (ViewBag.PageCode != "ExpertSpeaks")
    {
    <div class="outer_container clearfix">
        <div class="inner_menu_container clearfix">
            <!--<div class="home_icon">-->
                <!--<a href="index.html"><img src="images/home.png"></a>-->
            <!--</div>-->
            <div class="inner_container clearfix">
                <div class="SecondaryMenu">
                    @Html.Raw(new AudioHelper().Submenu().ToString())
                </div>
            </div>
        </div>
    </div>
    }
}