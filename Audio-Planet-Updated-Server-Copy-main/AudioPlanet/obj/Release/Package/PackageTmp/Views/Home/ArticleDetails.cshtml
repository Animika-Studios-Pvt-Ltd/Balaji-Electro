<div class="container">
    <div class="row1">
        <div class="row">
            <div class="col-lg-8 col-md-8 col-sm-8">
                <div class="ArticlesLeftPanel">
                    <div  id="ArticlesLeftPanel">
                        <div class="ArticlesHead">
                            <div class="ArtcilesTitle">
                                <h2>@Model.Title</h2>
                                <span>Posted on @(Model.PostedTime.ToString("dd / MM / yyyy"))</span>
                                <a href="#" data-src="@(new AudioHelper().GetUrl("Article", Model.Url))" class="shareFB">
                                <img src="/Content/Public/images/share_fb.png" alt="share on facebook"></a>
                            </div>
                        </div>
                        <div class="ArticlesDetails">
                            @Html.Raw(Model.Content)
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-4 col-sm-4">
                <div class="ArticlesRightPanel" id="ArticlesRightPanel" style="margin-bottom:100px;">
                    @{
                        Html.RenderPartial("Widgets/SearchArticle");
                        Html.RenderPartial("Widgets/ArticleCategories", (IEnumerable<AudioPlanet.Models.Page>)ViewBag.Categories);
                        Html.RenderPartial("Widgets/LatestArticles", (IEnumerable<Article>)ViewBag.LatestArticles);
                    }
                </div>
                <div style="height:100px;"></div>
            </div>
        </div>
    </div>
</div>