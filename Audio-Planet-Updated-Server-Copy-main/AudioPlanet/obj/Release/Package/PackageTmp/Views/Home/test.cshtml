                    @Html.Raw(new AudioHelper().MainMenu().ToString())
                </div>
            </div>
        </div>
        <!--</div>-->
    </nav>
</div>
    </div>

    <script type="text/javascript">
        $(document).ready(function () {
            if ($(".fancyboxPdf").length > 0) {
                $(".fancyboxPdf").fancybox({
                    openEffect: 'elastic',
                    closeEffect: 'elastic',
                    openEasing: 'swing'
                });
            }
            if ($(".fancybox").length > 0) {
                $(".fancybox").fancybox({
                    maxWidth: 800,
                    maxHeight: 600,
                    fitToView: false,
                    width: '500px',
                    height: 'auto',
                    autoSize: false,
                    closeClick: false,
                    openEffect: 'elastic',
                    closeEffect: 'elastic',
                    openEasing: 'swing',
                    beforeShow: function () {
                        if (this.title) {
                            // New line
                            this.title += '<br />';

                            // Add tweet button
                            this.title += '<a href="https://twitter.com/share" class="twitter-share-button" data-count="none" data-url="' + this.href + '">Tweet</a> ';

                            // Add FaceBook like button
                            this.title += '<iframe src="//www.facebook.com/plugins/like.php?href=' + this.href + '&amp;layout=button_count&amp;show_faces=true&amp;width=500&amp;action=like&amp;font&amp;colorscheme=light&amp;height=23" scrolling="no" frameborder="0" style="border:none; overflow:hidden; width:110px; height:23px;" allowTransparency="true"></iframe>';
                        }
                    },
                    afterShow: function () {
                        // Render tweet button
                        twttr.widgets.load();
                    },
                    helpers: {
                        title: {
                            type: 'outside'
                        },
                        overlay: {
                            css: {
                                'background': 'rgba(238,238,238,0.85)'
                            }
                        }
                    }
                });
            }
        });
</script>

    @Html.Partial("../Home/_Footer")



<!--==================================== Floating Menu ==========================-->
<div class="FloatingMenu">
    <img src="/Content/Public/images/floatingMenu.png" border="0" usemap="#Map" alt="floating menu"/>
    <map name="Map" id="Map">
        <area shape="rect" coords="1,4,43,49" href="http://www.facebook.com/pages/Audio-Planet/422869287795501"
                target="_blank" alt="Facebook" />
        <area shape="rect" coords="-3,53,43,95" href="https://twitter.com/AudioPlanetHub"
                target="_blank" alt="twitter" />
    </map>
</div>
<!--==================================== Floating Menu ends ==========================-->

