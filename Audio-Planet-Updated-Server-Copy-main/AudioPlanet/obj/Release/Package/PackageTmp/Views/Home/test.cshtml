            <div class="col-lg-3 col-md-3 col-sm-12 padding_zero">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navHeaderCollapse">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>

                    <div class="logo_container clearfix">
                        <a href="/"><img src="/images/AudioPlanet_Logo.png" class="img-responsive"></a>
                    </div>
                </div>
            </div>
            <div class="col-lg-9 col-md-9 col-sm-12 padding_zero">
