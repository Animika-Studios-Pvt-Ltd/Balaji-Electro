@using AudioPlanet.Models
@model IEnumerable<Picture>
@{
    ViewBag.Title = "Image Library";
    Layout = null;
}
@Content.Script("jquery-1.5.1.min.js", Url)
<!-- <script src="http://ajax.googleapis.com/ajax/libs/jquery/1.4.2/jquery.min.js"></script> -->
@Content.Script("tiny_mce/tiny_mce_popup.js", Url)
<script type="text/javascript">
    jQuery.expr[':'].Contains = function (a, i, m) {
        return (a.textContent || a.innerText || "").toUpperCase().indexOf(m[3].toUpperCase()) >= 0;
    };

    function listFilter(header, list) { // header is any element, list is an unordered list
        // create and add the filter form to the header
        var form = $("<form>").attr({ "class": "filterform", "action": "#" }),
            input = $("<input>").attr({ "class": "filterinput", "type": "text" });
        $(form).append(input).appendTo(header);

        $(input).change(function () {
            var filter = $(this).val();
            if (filter) {
                // this finds all links in a list that contain the input,
                // and hide the ones not containing the input while showing the ones that do
                $(list).find("em:not(:Contains(" + filter + "))").parent().parent().slideUp();
                $(list).find("em:Contains(" + filter + ")").parent().parent().slideDown();
            }
            else {
                $(list).find("li").slideDown();
            }
            return false;
        })
            .keyup(function () { // fire the above change event after every letter
                $(this).change();
            });
    }

    $(document).ready(function () {

        $(function () {
            listFilter($("#header"), $("#grid"));
        });

        $('.myimage').click(function () {
            var $src = $(this).attr('title');
            if (!$src) return false;
            //Image
            var $input = $(window.top.document).find('iframe[src*="advimage/image.htm"]').contents().find('input#src');
            //Media
            var $minput = $(window.top.document).find('iframe[src*="media/media.htm"]').contents().find('input#src');
            //Links
            var $finput = $(window.top.document).find('iframe[src*="advlink/link.htm"]').contents().find('input#href');
            //Background
            var $binput = $(window.top.document).find('iframe[src*="table/table.htm"]').contents().find('input#backgroundimage');

            $input.val($src).change();
            $minput.val($src).change();
            $finput.val($src).change();
            $binput.val($src).change();

            tinyMCEPopup.close();
            return false;
        });
    });
</script>
<style>
    table
    {
        border: dotted 1px #999999;
        border-collapse: collapse;
        width: 100%;
    }
    
    table td
    {
        border: dotted 1px #999999;
        font-size: 1.0em;
        padding: 1px 5px;
    }
    
    table th
    {
        background-color: #F4F4F4;
        border: dotted 1px #999999;
        font-size: 1.2em;
        padding: 1px 5px;
        text-align: left;
    }
    
    ul#grid
    {
        list-style: none;
        margin: 20px auto 0;
        width: 100%; /*was 468*/
    }
    
    #grid li
    {
        float: left;
        width: 129px;
        height: 210px;
        padding-right: 80px;
    }
    
    .portfolio
    {
        /*was 510*/ /*these two properties will be inherited by .portfolio h2 and .portfolio p */
        font-family: 'GraublauWeb' , arial, serif;
        margin-left: auto;
        margin-right: auto;
        margin-top: 10px;
        padding: 0px;
        text-align: center; /*background-color: #ffd7ce;*/
        width: 100%;
    }
    
    h2
    {
        font-family: 'GraublauWeb' , arial, serif;
        clear: both;
        color: #58595b;
        font-size: 24px;
        font-weight: normal;
        text-indent: 20px;
        -ms-text-shadow: 1px 1px 1px #aaa;
        text-shadow: 1px 1px 1px #aaa;
    }
    
    .portfolio p
    {
        color: #58595b;
        font-size: 15px;
        padding-left: 50px;
        text-align: left;
        -ms-text-shadow: 1px 1px 1px #aaa;
        text-shadow: 1px 1px 1px #aaa;
    }
    
    .portfolio em
    {
        color: #58595b;
        font-style: normal;
    }
    .filterform
    {
        width: 220px;
        font-size: 12px;
        display: block;
    }
    .filterform input
    {
        -moz-border-radius: 5px;
        -ms-border-radius: 5px;
        -webkit-border-radius: 5px;
        border-radius: 5px;
    }
    
    #grid li a:hover img
    {
        filter: alpha(opacity=30);
        -ms-opacity: 0.3;
        opacity: 0.3;
    }
    
    #grid li a img
    {
        background-color: white;
        border: 1px dotted #58595b;
        height: 125px;
        margin: 0;
        padding: 7px;
        width: 129px;
    }
    
    #grid li a
    {
        display: block;
    }
    
    .info
    {
        color: #58595b;
        font-size: 10px;
        padding-top: 0;
        text-align: left;
    }
    div.filters
    {
        font-family: 'GraublauWeb' ,arial,serif;
        font-size: 14px;
        float: right;
        padding: 5px 0;
        background: #FEF9E9;
        width: 100%;
        text-indent: 14px;
        color: brown;
    }
    div.filters a
    {
        color: brown;
    }
</style>
<h2>
    File Manager</h2>
<table>
    <tr>
        <td>
            @using (Html.BeginForm("Upload", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <fieldset>
                    <legend>Upload new File</legend>
                    <div class="editor-field">
                        <input type="file" name="file" />
                    </div>
                    <p>
                        <input type="submit" value="Upload" class="ibutton" />
                    </p>
                </fieldset>
            }
            <div class="filters">
                <strong><a href="/Admin/ChangeType/?mediaType=image">Images</a></strong>&nbsp;|&nbsp;
                <strong><a href="/Admin/ChangeType/?mediaType=media">Media files</a> </strong>&nbsp;|&nbsp;
                <strong><a href="/Admin/ChangeType/?mediaType=file">Document and Others</a></strong>&nbsp;|&nbsp;
                <strong><a href="/Admin/ChangeType/?mediaType=all">All</a></strong> <span id="header"
                    style="float: left"></span>
            </div>
        </td>
    </tr>
    <tr>
        <td style="width: 70%">
            <div class="portfolio">
                <p>
                    Media Type: @ViewContext.RouteData.Values["id"]</p>
                <ul id="grid">
                    @foreach (Picture name in Model)
                    {
                        switch (name.Extension)
                        {
                            case ".jpg":
                            case ".png":
                            case ".gif":
                        <li class="@(name.Media)"><a href="#">
                            <img src="@name.Url" alt="@name.AltText" class="myimage" title="@name.Url"/></a>
                            <div class="info">
                                <strong>Name&nbsp;:&nbsp;</strong><em>@(name.Name)</em><br />
                                <strong>Size&nbsp;:&nbsp;</strong>@(name.Length)<br />
                                <strong>Resolution&nbsp;:&nbsp;</strong>@(name.Width)
                                X @(name.Height)<br />
                                <strong><a href="/Admin/Delete/?url=@name.Url" onclick="javascript:return confirm('Are you Sure?');"  style="color:brown; font-size:11px; font-weight:bold;">
                                    Delete</a></strong>
                            </div>
                        </li>
                                                               break;
                            case ".swf":
                            case ".ram":
                            case ".flv":
                            case ".mov":
                            case ".avi":
                            case ".doc":
                            case ".docx":
                            case ".xls":
                            case ".xlsx":
                            case ".ppt":
                            case ".pptx":
                            case ".pdf":
                            case ".odp":
                            case ".ods":
                            case ".odt":
                        <li class="@(name.Media)"><span class="myimage" title="@name.Url" style="cursor: pointer;" >
                            <a href="#">
                                <img src="/Content/FiletypeIcons/filetype_@(name.Extension.Replace(".", "")).png" alt="@name.AltText"/></a>
                        </span>
                            <div class="info">
                                <strong>Name&nbsp;:&nbsp;</strong><em>@(name.Name)</em><br />
                                <strong>Size&nbsp;:&nbsp;</strong>@(name.Length)<br />
                                <strong><a href="/Admin/Delete/?url=@name.Url" onclick="javascript:return confirm('Are you Sure?');" style="color:brown; font-size:11px; font-weight:bold;">
                                    Delete</a></strong>
                            </div>
                        </li>
                                                               break;
                        }
                    }
                </ul>
            </div>
        </td>
    </tr>
</table>
