@{
    ViewBag.Title = "Google Analytics - Raw data";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2>
    Google Analytics - Raw data</h2>
<h4>
    Raw Analytics between Dates</h4>
@*<iframe src="/GA/RawAnalytics.htm" frameborder="0" width="100%" height="400px"></iframe>*@

<table style="border: none transparent">
    <tr>
        <td style="border: none transparent">
            <p class="buttons">
                <button id="authorize-button" class="ibutton">
                    Authorize</button>
            </p>
        </td>
        @*<td style="visibility: hidden">
            Table Id:
        </td>
        <td style="visibility: hidden">
            <input type="text" id="table-id" />
            <p class="note">
                Format is ga:xxx where xxx is your profile ID.</p>
        </td>*@
        <td class="editor-label" style="border: none transparent">
            Start Date:
        </td>
        <td class="editor-field" style="border: none transparent">
            <input type="text" id="start-date" style="width: 70px" />
        </td>
        <td class="editor-label" style="border: none transparent">
            End Date:
        </td>
        <td class="editor-field" style="border: none transparent">
            <input type="text" id="end-date" style="width: 70px" />
        </td>
        <td style="border: none transparent">
            <p class="buttons">
                <button id="run-demo-button" class="ibutton" style="visibility: hidden">
                    Run Demo</button>
            </p>
        </td>
    </tr>
</table>
<div id="output">
    Loading, one sec....</div>
<div style="width: 500px">
    <div style="width: 100%">
        <div id="chart">
        </div>
    </div>
    <div style="width: 100%">
        <table class="display">
            <tr>
                <th>
                    Country
                </th>
                <th>
                    Visitors
                </th>
                <th>
                    New Visitors
                </th>
                <th>
                    (%) New Visits
                </th>
            </tr>
            <tbody id="idOfDynamic">
            </tbody>
        </table>
    </div>
</div>
<script type="text/javascript" src="https://www.google.com/jsapi"></script>
<script type="text/javascript">
    // Load the Visualization API and the piechart package.
    google.load('visualization', '1.0', { 'packages': ['corechart'] });

    // Set a callback to run when the Google Visualization API is loaded.
    google.setOnLoadCallback(drawChart);

    // Callback that creates and populates a data table, 
    // instantiates the pie chart, passes in the data and
    // draws it.
    function drawChart() {

        // Create the data table.
        var data = new google.visualization.DataTable();
        data.addColumn('string', 'Country / Territory');
        data.addColumn('number', 'Visits');
        data.addRows([
            ['India', 4]
        ]);

        // Set chart options
        var options = { 'title': 'How many visitors visited Audio planet last day?',
            'width': 300,
            'height': 200
        };

        // Instantiate and draw our chart, passing in some options.
        var chart = new google.visualization.PieChart(document.getElementById('chart'));
        chart.draw(data, options);
    }
</script>
<script src="/GA/auth_util.js" type="text/javascript"></script>
<script src="/GA/core_reporting_api_v3_reference.js" type="text/javascript"></script>
<script src="https://apis.google.com/js/client.js?onload=handleClientLoad" type="text/javascript"></script>
