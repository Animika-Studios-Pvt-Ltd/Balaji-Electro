@model AudioPlanet.Models.AdminUser

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="buttons">
    <a href="@Url.Action("Index")" class = "button left"><span class="icon icon63"></span>
        <span class="label">Admin Users</span></a>
</div>
<h2>
    Delete Admin User</h2>
<h3>
    Are you sure you want to delete?
</h3>
@using (Html.BeginForm())
{
    <input type="submit" value="Delete" class="ibutton delete" />
}
<fieldset>
    <legend>AdminUser</legend>

    <div class="display-label">Name</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.Name)
    </div>

    <div class="display-label">Email</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.Email)
    </div>

    <div class="display-label">Password</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.Password)
    </div>

    <div class="display-label">IsActive</div>
    <div class="display-field">
        @Html.DisplayFor(model => model.IsActive)
    </div>
</fieldset>
<div class="buttons">
    <a href="@Url.Action("Index")" class = "button left"><span class="icon icon63"></span>
        <span class="label">Admin Users</span></a>
</div>
